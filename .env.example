# ---- Site ----
# Public URL of the deployed site (used for SEO: canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key both work
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. NEVER expose. The "secret" key (sb_secret_...) or legacy service_role key
SUPABASE_SECRET_KEY=''

# ---- Email (Hostinger SMTP, sender community@playnearbygames.com) ----
# Server only. NEVER commit it. Used for two things:
#  1. Request emails sent by the app (new request → host, accepted/declined → player).
#     Set it on Vercel too, or those emails are skipped (logged, never an error for the user).
#  2. Sign-in codes when running `npx supabase start` locally (supabase/config.toml). For the
#     hosted project, enter the same password in Supabase Dashboard → Authentication → SMTP.
HOSTINGER_SMTP_PASSWORD=
# Optional overrides (defaults: smtp.hostinger.com, 465, community@playnearbygames.com)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=

# ---- Google Maps (console.cloud.google.com → APIs: Maps JavaScript, Places (New), Geocoding) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID with "JavaScript / Vector" type (Google Cloud → Map Management). Needed for custom markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---- Razorpay (dashboard.razorpay.com → Test mode → API Keys) ----
# Leave empty to record UPI/card payments as "pending" (wallet + in-person still work)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Feature flags ----
# Turn on once an SMS provider (Twilio / MSG91) is configured in Supabase Auth → Phone
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
# Needs an Apple Developer account
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false
